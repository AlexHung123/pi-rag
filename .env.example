# Postgres
DATABASE_URL=postgresql://pi_rag:pi_rag@localhost:5432/pi_rag?schema=public

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth
AUTH_ALLOW_REGISTER=true
SESSION_TTL_DAYS=7
ADMIN_USERNAME=
ADMIN_PASSWORD=
COOKIE_SECURE=false

# RAGFlow (set RAGFLOW_MOCK=true to use local mock engine without RAGFlow)
RAGFLOW_BASE_URL=http://localhost:8001
RAGFLOW_API_KEY=
RAGFLOW_MOCK=false

# OpenAI-compatible LLM for pi-agent-core chat.
# Required: set BASE_URL and/or API_KEY (local servers often only need BASE_URL).
OPENAI_BASE_URL=http://192.168.1.11:443/v1
OPENAI_MODEL=qwen3.6-35b-a3b-mlx
OPENAI_API_KEY=not-needed

# In-memory conversation agent pool (pi-agent-core).
# One Agent per conversation while the slot is live; restarts rebuild from Postgres.
AGENT_POOL_MAX=100
AGENT_SESSION_TTL_MS=1800000
AGENT_HISTORY_LIMIT=20
AGENT_PROMPT_WAIT_MS=120000
