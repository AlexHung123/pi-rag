# Postgres
DATABASE_URL=postgresql://pi_rag:pi_rag@localhost:5432/pi_rag?schema=public

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth
AUTH_ALLOW_REGISTER=true
SESSION_TTL_DAYS=7
ADMIN_USERNAME=
ADMIN_PASSWORD=
COOKIE_SECURE=false

# RAGFlow (leave API key empty to use local mock engine for UI dev)
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_MOCK=true

# LLM for pi-agent-core chat (optional until P3 real model wiring)
# When unset, chat returns a guided stub response using tools only for KB ops.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
