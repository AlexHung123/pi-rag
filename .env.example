# Postgres
DATABASE_URL=postgresql://pi_rag:pi_rag@localhost:5432/pi_rag?schema=public

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth
AUTH_ALLOW_REGISTER=true
SESSION_TTL_DAYS=7
ADMIN_USERNAME=
ADMIN_PASSWORD=
COOKIE_SECURE=false

# Upload limits
# Single-file hard cap (bytes). Default 50 MiB.
MAX_UPLOAD_BYTES=52428800
# Per-user total storage quota for all uploaded documents (bytes). Default 5 GiB.
# Admins can override per user in the Admin → Users UI.
DEFAULT_STORAGE_QUOTA_BYTES=5368709120

# RAGFlow
# - Real engine: set RAGFLOW_BASE_URL + RAGFLOW_API_KEY, leave RAGFLOW_MOCK=false
# - Local mock (in-memory, no RAGFlow): RAGFLOW_MOCK=true
# - Dev convenience: if RAGFLOW_API_KEY is empty and RAGFLOW_MOCK is unset, mock is used
#   with a loud startup warning. Production requires API key unless RAGFLOW_MOCK=true.
RAGFLOW_BASE_URL=http://localhost:8001
RAGFLOW_API_KEY=
RAGFLOW_MOCK=false

# Retrieval quality (P0). Applied to RAGFlow /api/v1/retrieval + agent tools.
# page_size = evidence chunks returned to the agent; top_k = over-retrieve pool.
RAG_PAGE_SIZE=10
RAG_TOP_K=30
RAG_SIMILARITY_THRESHOLD=0.2
# Hybrid mix: 1 = pure vector, 0 = pure keyword (RAGFlow vector_similarity_weight)
RAG_VECTOR_SIMILARITY_WEIGHT=0.7
# Optional RAGFlow rerank model id (leave empty if not configured in RAGFlow)
RAG_RERANK_ID=
# Max chars per chunk in the tool evidence text (UI sources keep full content)
RAG_MAX_CHUNK_CHARS=1200
# Multi-query: split multi-part questions / accept queries[] from the agent
RAG_MULTI_QUERY=true
RAG_MULTI_QUERY_MAX=3
# LLM multi-turn query rewrite before agent prompt (uses OPENAI_* endpoint)
RAG_QUERY_REWRITE=true

# Keyword path (P1a keyword_search tool): low vector weight + optional ES keyword flag.
# RAGFlow score ≈ vector_weight * vector + (1 - vector_weight) * term.
RAG_KEYWORD_VECTOR_WEIGHT=0.1
RAG_KEYWORD_SIMILARITY_THRESHOLD=0.1
# Pass keyword=true on POST /api/v1/retrieval (ElasticSearch term matching)
RAG_KEYWORD_ENABLE_ES=true
# list_document_chunks: total char budget + hard pageSize cap
RAG_LIST_DOC_CHAR_BUDGET=7000
RAG_LIST_DOC_PAGE_SIZE_MAX=20
# P1d: attach prev/next chunk from listChunks order for top hits
RAG_ADJACENT_EXPAND=true
RAG_ADJACENT_EXPAND_MAX_HITS=3

# OpenAI-compatible LLM for pi-agent-core chat.
# Required: set BASE_URL and/or API_KEY (local servers often only need BASE_URL).
OPENAI_BASE_URL=http://192.168.1.11:8000/v1
OPENAI_MODEL=qwen3.6-35b-a3b-mlx
OPENAI_API_KEY=not-needed

# Dump full LLM request payloads under apps/api/data/llm-debug/ (sensitive).
# Default off. Enable only when debugging gateway/model errors.
LLM_DEBUG=false

# In-memory conversation agent pool (pi-agent-core).
# One Agent per conversation while the slot is live; restarts rebuild from Postgres.
AGENT_POOL_MAX=100
AGENT_SESSION_TTL_MS=1800000
AGENT_HISTORY_LIMIT=20
AGENT_PROMPT_WAIT_MS=120000
