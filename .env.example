# Postgres
DATABASE_URL=postgresql://pi_rag:pi_rag@localhost:5432/pi_rag?schema=public

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth (users are created by admin only; optional first admin via ADMIN_*)
SESSION_TTL_DAYS=7
ADMIN_USERNAME=
ADMIN_PASSWORD=
COOKIE_SECURE=false

# Upload limits
# Single-file hard cap for non-audio documents (bytes). Default 1 GiB.
MAX_UPLOAD_BYTES=1073741824
# Audio-specific hard cap (bytes). Default 1 GiB.
MAX_AUDIO_UPLOAD_BYTES=1073741824
# Per-user total storage quota for all uploaded documents (bytes). Default 5 GiB.
# Admins can override per user in the Admin â†?Users UI.
DEFAULT_STORAGE_QUOTA_BYTES=5368709120

# Local media store for original audio (relative to apps/api cwd unless absolute)
MEDIA_ROOT=data/media

# Speech-to-text (OpenAI-compatible HTTP). Browser never talks to STT directly.
# Dev without real STT: STT_MOCK=true
# FunASR SenseVoice (Cantonese-friendly), e.g. Ultra LAN:
#   STT_BASE_URL=http://192.168.1.11:8002
#   STT_MODEL=sensevoice
#   STT_DEFAULT_LANGUAGE=yue
STT_BASE_URL=http://192.168.1.11:8002
STT_API_KEY=
STT_MODEL=sensevoice
STT_DEFAULT_LANGUAGE=yue
STT_TIMEOUT_MS=3600000
STT_WORKER_CONCURRENCY=1
STT_JOB_STALE_MS=7200000
STT_JOB_MAX_ATTEMPTS=3
STT_POLL_INTERVAL_MS=2000
STT_AUTO_PARSE=true
# When false (default): stop after STT and let user preview + click Ingest.
# When true: automatically upload transcript to RAGFlow (then STT_AUTO_PARSE).
STT_AUTO_INGEST=false
STT_MOCK=false
# Speaker diarization (FunASR form spk=true). Set true when STT server supports it.
STT_SPK=true
# Preferred: remote STT converts video in-process (your unified server on :8002).
# Do NOT set STT_CLIENT_TRANSCODE unless the remote STT cannot accept mp4.
STT_CLIENT_TRANSCODE=false
# Legacy client-side ffmpeg (only when STT_CLIENT_TRANSCODE=true):
STT_FFMPEG_BIN=ffmpeg
STT_FFMPEG_TIMEOUT_MS=3600000
# STT_FFMPEG_SSH=user@192.168.1.11
# STT_FORCE_WAV=false


# RAGFlow
# - Real engine: set RAGFLOW_BASE_URL + RAGFLOW_API_KEY, leave RAGFLOW_MOCK=false
# - Local mock (in-memory, no RAGFlow): RAGFLOW_MOCK=true
# - Dev convenience: if RAGFLOW_API_KEY is empty and RAGFLOW_MOCK is unset, mock is used
#   with a loud startup warning. Production requires API key unless RAGFLOW_MOCK=true.
RAGFLOW_BASE_URL=http://localhost:8001
RAGFLOW_API_KEY=
RAGFLOW_MOCK=false

# Retrieval quality (P0). Applied to RAGFlow /api/v1/retrieval + agent tools.
# page_size = evidence chunks returned to the agent; top_k = over-retrieve pool.
RAG_PAGE_SIZE=50
RAG_TOP_K=50
RAG_SIMILARITY_THRESHOLD=0.2
# Hybrid mix: 1 = pure vector, 0 = pure keyword (RAGFlow vector_similarity_weight)
RAG_VECTOR_SIMILARITY_WEIGHT=0.7
# Optional RAGFlow rerank model id (leave empty if not configured in RAGFlow)
RAG_RERANK_ID=
# Max chars per chunk body in retrieve/keyword tool text for the LLM.
# Default 4000. Set 0 only if you intentionally want full unlimited chunks.
RAG_MAX_CHUNK_CHARS=4000
# Hard cap on total characters of one retrieve/keyword tool result (all hits).
# Prevents a single RAG call from exceeding the model context window.
# 0 = no total budget (only per-chunk RAG_MAX_CHUNK_CHARS applies).
RAG_EVIDENCE_MAX_CHARS=120000
# Multi-query: split multi-part questions / accept queries[] from the agent
RAG_MULTI_QUERY=true
RAG_MULTI_QUERY_MAX=3
# LLM multi-turn query rewrite before agent prompt (uses OPENAI_* endpoint).
# Default false: leave query understanding to the agent (tools + history).
# Set true only if you want a cheap self-contained retrieval hint for multi-turn.
RAG_QUERY_REWRITE=false

# Keyword path (keyword_search tool): RAGFlow POST /api/v1/retrieval
# with vector_similarity_weight=0 (pure term ranking), highlight=true, keyword=false.
# Candidate pool (RAGFlow top_k). Response page_size is capped at 100 by RAGFlow.
RAG_KEYWORD_TOP_K=1024
# Drop weak hits below this similarity (0 = keep all scored hits)
RAG_KEYWORD_SIMILARITY_THRESHOLD=0.15
# 0 = pure term ranking, 1 = pure vector (default 0 for keyword_search)
RAG_KEYWORD_VECTOR_WEIGHT=0

# summarize_document tool: load all ordered chunks, merge, hand to agent
RAG_SUMMARIZE_LIST_PAGE_SIZE=50
RAG_SUMMARIZE_MAX_CHUNK_CHARS=4000
# Hard cap on total summarize_document tool text (header + chunks). 0 = unlimited.
RAG_SUMMARIZE_MAX_TOTAL_CHARS=80000

# OpenAI-compatible LLM for pi-agent-core chat.
# Required: set BASE_URL and/or API_KEY (local servers often only need BASE_URL).
OPENAI_BASE_URL=http://192.168.1.11:8000/v1
# Default model id (used when the client omits modelId).
OPENAI_MODEL=qwen3.6-35b-a3b-mlx
# Optional comma-separated allowlist for per-message model selection in the UI.
# Each entry is key=value: modelId=Display Name (plain modelId also works; name defaults to id).
# If empty, only OPENAI_MODEL is offered. If set and default is missing, default is prepended.
OPENAI_MODELS=qwen3.6-35b-a3b-mlx=Qwen 3.6 35B,qwen3.6-27b-fable-fusion-711-uncensored-heretic-nm-dau-neo-max-mtp=Fable 27B
OPENAI_API_KEY=not-needed

# Dump full LLM request payloads under apps/api/data/llm-debug/ (sensitive).
# Default off. Enable only when debugging gateway/model errors.
LLM_DEBUG=false

# In-memory conversation agent pool (pi-agent-core).
# One Agent per conversation while the slot is live; restarts rebuild from Postgres.
AGENT_POOL_MAX=100
AGENT_SESSION_TTL_MS=1800000
AGENT_HISTORY_LIMIT=20
AGENT_PROMPT_WAIT_MS=120000
# Per-prompt safety caps (prevents tool-call dead loops).
# Max tool executions allowed in one user message (default 15).
AGENT_MAX_TOOL_CALLS=15
# Max consecutive failures of the same tool+args before further identical calls are blocked (default 2).
AGENT_TOOL_MAX_FAILURES=2
# Hard cap on LLM turns per prompt; exceeding aborts the run (default 25).
AGENT_MAX_TURNS=25
# Lightweight in-memory compaction (bare Agent; not Postgres).
# Runs before every LLM call via transformContext (including mid-run after
# tool results). Caps oversized tool bodies then summarizes older history.
AGENT_COMPACTION_ENABLED=true
# Optional hard threshold (tokens). If unset: min(contextWindow - reserve, 150000).
# AGENT_COMPACTION_THRESHOLD_TOKENS=150000
AGENT_COMPACTION_RESERVE_TOKENS=16384
AGENT_COMPACTION_KEEP_RECENT_TOKENS=20000
# Max chars of a single toolResult body in transformContext (defaults to
# RAG_EVIDENCE_MAX_CHARS / 120000). Safety net if tool formatting missed a cap.
# AGENT_MAX_TOOL_RESULT_CHARS=120000

# Personal memory (L1 profile + L2 items) prompt injection
MEMORY_INJECTION_ENABLED=true
MEMORY_PROMPT_MAX_TOKENS=2000
MEMORY_PROMPT_MAX_ITEMS=15
MEMORY_MAX_PINNED=15
# Chat memory_save only: optional LLM polish to one sentence (UI/admin still verbatim).
# On failure or dropped proper nouns â†?keep original content.
MEMORY_POLISH_ENABLED=true
# Optional dedicated model (defaults to OPENAI_MODEL)
# MEMORY_POLISH_MODEL=
MEMORY_POLISH_TIMEOUT_MS=15000
MEMORY_POLISH_MAX_TOKENS=256
