generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum DocumentStatus {
  unstart
  running
  done
  fail
}

enum DocumentSourceType {
  file
  audio
}

enum TranscriptionJobStatus {
  queued
  running
  done
  failed
  cancelled
}

enum MessageRole {
  user
  assistant
  tool
  system
}

enum KnowledgeBaseVisibility {
  private
  public
}

enum KnowledgeBaseRole {
  viewer
  editor
}

enum MemoryCategory {
  preference
  fact
  project
  other
}

enum MemorySource {
  manual
  extracted
}

enum MemoryStatus {
  active
  archived
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  passwordHash       String    @map("password_hash")
  role               Role      @default(user)
  /// Total storage quota for all uploaded documents (bytes). Default 5 GiB.
  storageQuotaBytes  BigInt    @default(5368709120) @map("storage_quota_bytes")
  disabledAt         DateTime? @map("disabled_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  sessions              Session[]
  knowledgeBases        KnowledgeBase[]
  knowledgeBaseMembers  KnowledgeBaseMember[]
  documents             Document[]
  conversations         Conversation[]
  profile               UserProfile?
  memoryItems           MemoryItem[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  csrfSecret String    @map("csrf_secret")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model KnowledgeBase {
  id               String                  @id @default(uuid()) @db.Uuid
  ownerUserId      String                  @map("owner_user_id") @db.Uuid
  ragflowDatasetId String                  @unique @map("ragflow_dataset_id")
  name             String
  description      String                  @default("")
  chunkMethod      String                  @default("naive") @map("chunk_method")
  parserConfig     Json                    @default("{}") @map("parser_config")
  visibility       KnowledgeBaseVisibility @default(private)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  owner     User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  documents Document[]
  members   KnowledgeBaseMember[]

  @@unique([ownerUserId, name])
  @@index([ownerUserId])
  @@index([visibility])
  @@map("knowledge_bases")
}

model KnowledgeBaseMember {
  id              String            @id @default(uuid()) @db.Uuid
  knowledgeBaseId String            @map("knowledge_base_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  role            KnowledgeBaseRole @default(viewer)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, userId])
  @@index([userId])
  @@map("knowledge_base_members")
}

model Document {
  id                  String             @id @default(uuid()) @db.Uuid
  knowledgeBaseId     String             @map("knowledge_base_id") @db.Uuid
  ownerUserId         String             @map("owner_user_id") @db.Uuid
  /// Null until transcript is uploaded to RAGFlow (audio pipeline).
  ragflowDocumentId   String?            @map("ragflow_document_id")
  name                String
  sizeBytes           BigInt             @default(0) @map("size_bytes")
  status              DocumentStatus     @default(unstart)
  progress            Float              @default(0)
  progressMsg         String?            @map("progress_msg")
  chunkCount          Int                @default(0) @map("chunk_count")
  errorMessage        String?            @map("error_message")
  /// RAGFlow process_duration (seconds) last synced from document list/get.
  processDuration     Float?             @map("process_duration")
  /// RAGFlow process_begin_at last synced from document list/get.
  processBeginAt      DateTime?          @map("process_begin_at")
  sourceType          DocumentSourceType @default(file) @map("source_type")
  /// Relative path under MEDIA_ROOT for original audio (audio only).
  mediaPath           String?            @map("media_path")
  mediaContentType    String?            @map("media_content_type")
  transcriptLanguage  String?            @map("transcript_language")
  durationSeconds     Float?             @map("duration_seconds")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  knowledgeBase     KnowledgeBase      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  owner             User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  transcriptionJobs TranscriptionJob[]

  @@index([knowledgeBaseId])
  @@index([ownerUserId])
  @@map("documents")
}

model TranscriptionJob {
  id              String                 @id @default(uuid()) @db.Uuid
  documentId      String                 @map("document_id") @db.Uuid
  knowledgeBaseId String                 @map("knowledge_base_id") @db.Uuid
  ownerUserId     String                 @map("owner_user_id") @db.Uuid
  status          TranscriptionJobStatus @default(queued)
  /// queued | probing | transcribing | writing | uploading | parsing | done
  stage           String                 @default("queued")
  progress        Float                  @default(0)
  progressMsg     String?                @map("progress_msg")
  language        String?
  sttModel        String?                @map("stt_model")
  attempts        Int                    @default(0)
  maxAttempts     Int                    @default(3) @map("max_attempts")
  lockedBy        String?                @map("locked_by")
  errorMessage    String?                @map("error_message")
  startedAt       DateTime?              @map("started_at")
  finishedAt      DateTime?              @map("finished_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([documentId])
  @@index([ownerUserId, createdAt])
  @@map("transcription_jobs")
}

model Conversation {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  title       String   @default("New chat")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner    User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([ownerUserId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  displayName   String?  @map("display_name")
  language      String?
  responseStyle String?  @map("response_style")
  bio           String   @default("")
  prefs         Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model MemoryItem {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  content    String
  category   MemoryCategory @default(other)
  pinned     Boolean        @default(false)
  importance Int            @default(3)
  source     MemorySource   @default(manual)
  status     MemoryStatus   @default(active)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, pinned, importance, updatedAt])
  @@index([userId, updatedAt])
  @@map("memory_items")
}
